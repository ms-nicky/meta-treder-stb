<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_root"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card"
        android:paddingLeft="22dp"
        android:paddingRight="22dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/symbol"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BTCUSDT"
                android:textColor="#2EE6A4"
                android:textSize="36sp"
                android:textStyle="bold"
                android:shadowColor="#20000000"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="2" />

            <View
                android:layout_width="1dp"
                android:layout_height="40dp"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:background="#263042" />

            <TextView
                android:id="@+id/price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="$--"
                android:textColor="#F2F5FA"
                android:textSize="36sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="  "
                android:textSize="26sp" />

            <TextView
                android:id="@+id/change"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+0.00%"
                android:textSize="26sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tv_clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--:--:-- WIB"
                android:textColor="#F0B90B"
                android:textSize="22sp"
                android:textStyle="bold" />

            <View
                android:layout_width="14dp"
                android:layout_height="1dp" />

            <Button
                android:id="@+id/btn_broker"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:minWidth="120dp"
                android:text=" MT5 "
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/btn_pair_text"
                android:background="@drawable/btn_update"
                android:focusable="true"
                android:stateListAnimator="@null"
                android:paddingLeft="14dp"
                android:paddingRight="14dp" />

            <View
                android:layout_width="10dp"
                android:layout_height="1dp" />

            <Button
                android:id="@+id/btn_update"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:minWidth="120dp"
                android:text=" UPDATE "
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/btn_pair_text"
                android:background="@drawable/btn_update"
                android:focusable="true"
                android:stateListAnimator="@null"
                android:paddingLeft="14dp"
                android:paddingRight="14dp" />

            <View
                android:layout_width="10dp"
                android:layout_height="1dp" />

            <TextView
                android:id="@+id/conn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="menghubungkan..."
                android:textColor="#6B7686"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#232C3B" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="24h H: "
                    android:textColor="#6B7686"
                    android:textSize="19sp" />
                <TextView
                    android:id="@+id/tv_high"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="#F2F5FA"
                    android:textSize="19sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="24h L: "
                    android:textColor="#6B7686"
                    android:textSize="19sp" />
                <TextView
                    android:id="@+id/tv_low"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="#F2F5FA"
                    android:textSize="19sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Vol 24h: "
                    android:textColor="#6B7686"
                    android:textSize="19sp" />
                <TextView
                    android:id="@+id/tv_vol"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="#F2F5FA"
                    android:textSize="19sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="USDT: "
                    android:textColor="#6B7686"
                    android:textSize="19sp" />
                <TextView
                    android:id="@+id/tv_qvol"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="#F2F5FA"
                    android:textSize="19sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:layout_marginTop="10dp">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2"
            android:background="@drawable/bg_card">

            <com.stb.markettrader.CandlestickChartView
                android:id="@+id/chart"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="6dp"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusDown="@id/btn_pair"
                android:nextFocusLeft="@id/watchlist"
                android:nextFocusRight="@id/watchlist" />
        </FrameLayout>

        <View
            android:layout_width="8dp"
            android:layout_height="1dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <EditText
                android:id="@+id/search"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_search"
                android:hint="Cari pair... (mis. BTC, EUR, XAU)"
                android:textColorHint="#5B6574"
                android:textColor="#F2F5FA"
                android:textSize="18sp"
                android:singleLine="true"
                android:inputType="textVisiblePassword"
                android:imeOptions="actionSearch"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusLeft="@id/chart"
                android:nextFocusDown="@id/watchlist" />

            <com.stb.markettrader.WatchlistView
                android:id="@+id/watchlist"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusUp="@id/search"
                android:nextFocusLeft="@id/chart"
                android:nextFocusDown="@id/btn_pair" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="◄ ► GESER / CHART-KANAN    ▲ ▼ ZOOM    OK RESET/MILIH    BACK ke MENU"
        android:textColor="#5B6574"
        android:textSize="16sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="10dp"
        android:focusable="true">

        <Button
            android:id="@+id/btn_pair"
            android:layout_width="0dp"
            android:layout_weight="1.6"
            android:layout_height="60dp"
            android:text="PAIR  ▾"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/btn_pair_text"
            android:background="@drawable/btn_pair"
            android:focusable="true"
            android:nextFocusUp="@id/chart"
            android:stateListAnimator="@null" />

        <Button
            android:id="@+id/btn_ind"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="60dp"
            android:text="MA"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/tf_text"
            android:background="@drawable/btn_tf"
            android:focusable="true"
            android:nextFocusUp="@id/chart"
            android:stateListAnimator="@null"
            android:layout_marginLeft="8dp" />

        <Button
            android:id="@+id/btn_sub"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="60dp"
            android:text="VOL"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/tf_text"
            android:background="@drawable/btn_tf"
            android:focusable="true"
            android:nextFocusUp="@id/chart"
            android:stateListAnimator="@null"
            android:layout_marginLeft="8dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="8dp"
        android:focusable="true">

        <Button
            android:id="@+id/tf_1m"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="1m"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/tf_text"
            android:background="@drawable/btn_tf"
            android:focusable="true"
            android:nextFocusUp="@id/btn_pair"
            android:stateListAnimator="@null"
            android:layout_marginLeft="3dp"
            android:layout_marginRight="3dp" />

        <Button
            android:id="@+id/tf_5m"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="5m"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/tf_text"
            android:background="@drawable/btn_tf"
            android:focusable="true"
            android:nextFocusUp="@id/btn_pair"
            android:stateListAnimator="@null"
            android:layout_marginLeft="3dp"
            android:layout_marginRight="3dp" />

        <Button
            android:id="@+id/tf_15m"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="15m"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/tf_text"
            android:background="@drawable/btn_tf"
            android:focusable="true"
            android:nextFocusUp="@id/btn_pair"
            android:stateListAnimator="@null"
            android:layout_marginLeft="3dp"
            android:layout_marginRight="3dp" />

        <Button
            android:id="@+id/tf_1h"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="1h"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/tf_text"
            android:background="@drawable/btn_tf"
            android:focusable="true"
            android:nextFocusUp="@id/btn_pair"
            android:stateListAnimator="@null"
            android:layout_marginLeft="3dp"
            android:layout_marginRight="3dp" />

        <Button
            android:id="@+id/tf_4h"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="4h"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/tf_text"
            android:background="@drawable/btn_tf"
            android:focusable="true"
            android:nextFocusUp="@id/btn_pair"
            android:stateListAnimator="@null"
            android:layout_marginLeft="3dp"
            android:layout_marginRight="3dp" />

        <Button
            android:id="@+id/tf_1d"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="1d"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/tf_text"
            android:background="@drawable/btn_tf"
            android:focusable="true"
            android:nextFocusUp="@id/btn_pair"
            android:stateListAnimator="@null"
            android:layout_marginLeft="3dp"
            android:layout_marginRight="3dp" />
    </LinearLayout>

</LinearLayout>
