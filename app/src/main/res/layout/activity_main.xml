<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_root"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_card"
        android:paddingLeft="22dp"
        android:paddingRight="22dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/symbol"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BTCUSDT"
            android:textColor="#2EE6A4"
            android:textSize="40sp"
            android:textStyle="bold"
            android:shadowColor="#20000000"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="2" />

        <View
            android:layout_width="1dp"
            android:layout_height="44dp"
            android:layout_marginLeft="18dp"
            android:layout_marginRight="18dp"
            android:background="#263042" />

        <TextView
            android:id="@+id/price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="$--"
            android:textColor="#F2F5FA"
            android:textSize="40sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="  "
            android:textSize="30sp" />

        <TextView
            android:id="@+id/change"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+0.00%"
            android:textSize="30sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/conn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="menghubungkan..."
            android:textColor="#6B7686"
            android:textSize="18sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_card">

        <com.stb.markettrader.CandlestickChartView
            android:id="@+id/chart"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="6dp" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="12dp"
        android:focusable="true">

        <Button
            android:id="@+id/btn_pair"
            android:layout_width="wrap_content"
            android:layout_height="64dp"
            android:minWidth="170dp"
            android:text="PAIR  ▾"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/btn_pair_text"
            android:background="@drawable/btn_pair"
            android:focusable="true"
            android:stateListAnimator="@null"
            android:paddingLeft="20dp"
            android:paddingRight="20dp" />

        <View
            android:layout_width="14dp"
            android:layout_height="1dp" />

        <Button
            android:id="@+id/tf_1m"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:text="1m"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/tf_text"
            android:background="@drawable/btn_tf"
            android:focusable="true"
            android:stateListAnimator="@null"
            android:layout_marginLeft="4dp"
            android:layout_marginRight="4dp" />

        <Button
            android:id="@+id/tf_5m"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:text="5m"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/tf_text"
            android:background="@drawable/btn_tf"
            android:focusable="true"
            android:stateListAnimator="@null"
            android:layout_marginLeft="4dp"
            android:layout_marginRight="4dp" />

        <Button
            android:id="@+id/tf_15m"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:text="15m"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/tf_text"
            android:background="@drawable/btn_tf"
            android:focusable="true"
            android:stateListAnimator="@null"
            android:layout_marginLeft="4dp"
            android:layout_marginRight="4dp" />

        <Button
            android:id="@+id/tf_1h"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:text="1h"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/tf_text"
            android:background="@drawable/btn_tf"
            android:focusable="true"
            android:stateListAnimator="@null"
            android:layout_marginLeft="4dp"
            android:layout_marginRight="4dp" />

        <Button
            android:id="@+id/tf_4h"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:text="4h"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/tf_text"
            android:background="@drawable/btn_tf"
            android:focusable="true"
            android:stateListAnimator="@null"
            android:layout_marginLeft="4dp"
            android:layout_marginRight="4dp" />

        <Button
            android:id="@+id/tf_1d"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:text="1d"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/tf_text"
            android:background="@drawable/btn_tf"
            android:focusable="true"
            android:stateListAnimator="@null"
            android:layout_marginLeft="4dp"
            android:layout_marginRight="4dp" />
    </LinearLayout>

</LinearLayout>