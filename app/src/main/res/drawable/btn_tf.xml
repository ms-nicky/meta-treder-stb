<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#0ECB81" />
            <corners android:radius="12dp" />
            <stroke
                android:width="1dp"
                android:color="#0ECB81" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#1E2A3C"
                android:endColor="#17202E"
                android:angle="270" />
            <corners android:radius="12dp" />
            <stroke
                android:width="2dp"
                android:color="#0ECB81" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#1C2331"
                android:endColor="#161C28"
                android:angle="270" />
            <corners android:radius="12dp" />
            <stroke
                android:width="1dp"
                android:color="#283244" />
        </shape>
    </item>
</selector>