<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#09A05E"
                android:endColor="#078B52"
                android:angle="270" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#16E095"
                android:endColor="#0ECB81"
                android:angle="270" />
            <corners android:radius="14dp" />
            <stroke
                android:width="2dp"
                android:color="#9FF3D5" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#12D484"
                android:endColor="#0FB56F"
                android:angle="270" />
            <corners android:radius="14dp" />
            <stroke
                android:width="1dp"
                android:color="#0A8F58" />
        </shape>
    </item>
</selector>